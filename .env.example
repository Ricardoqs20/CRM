# Ambiente e Segurança
DEBUG=True
SECRET_KEY=your-secret-key-here
WEBHOOK_API_KEY=your-webhook-api-key-here

# Chave opcional para criptografia de dados sensíveis em repouso (Fernet/HKDF-SHA256).
# Caso omitida ou vazia, uma chave criptográfica será derivada automaticamente da SECRET_KEY.
FIELD_ENCRYPTION_KEY=

# Hosts e Origens Confiáveis (separados por vírgula em produção)
ALLOWED_HOSTS=localhost,127.0.0.1,18.220.198.164.sslip.io
CSRF_TRUSTED_ORIGINS=https://18.220.198.164.sslip.io

# Banco de Dados (RDS PostgreSQL em produção; vazio usa SQLite local)
DATABASE_URL=
DB_CONN_MAX_AGE=600
DB_SSL_REQUIRE=False

# AWS S3 (Armazenamento de fotos e documentos; vazio usa MEDIA_ROOT local)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_STORAGE_BUCKET_NAME=
AWS_S3_REGION_NAME=us-east-1
AWS_S3_CUSTOM_DOMAIN=
AWS_QUERYSTRING_AUTH=True

# Google OAuth2 (Login e Sincronização Google Agenda)
